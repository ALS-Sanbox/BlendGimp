# --------------------------------------------------
# BlendGimp Git Ignore
# --------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Python environments
venv/
.venv/
env/
ENV/

# Blender temporary / backup files
*.blend1
*.blend2
*.blend@
*.blend~

# Blender autosave / temp
*.autosave

# GIMP temporary files
*.xcf~
*.gimp-temp
*.tmp
*.temp

# Operating system
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.vscode/
.idea/

# Logs
*.log
logs/

# Build output
build/
dist/
out/

# Native build files
native/build/
CMakeFiles/
CMakeCache.txt

# Test/cache output
.cache/
coverage/
htmlcov/

# Runtime/cache data
cache/
BlendGimp/cache/

# Packaged extensions
*.zip

# Large reference/source packages
blender-main*/
gimp-api-docs*/

# Executables / binaries
*.exe
*.dll
*.pdb
*.so
*.dylib

# GIMP installed/runtime copy
tools/gimp3/

# Local configuration/secrets
.env
.env.*
*.local.json

# Temporary project files
*.bak
*.old
*.swp
*.swo